---
import { Image } from "astro:assets";
import logo from "@assets/logo.jpg";
import Instagram from "@icons/Instagram.astro";
import Mail from "@icons/Mail.astro";
---

<footer
  class="z-10 mt-6 bg-blue-900 text-sm text-white"
  transition:animate="none"
>
  <div
    class="container mx-auto flex flex-col gap-4 px-4 py-8 md:grid md:grid-cols-[repeat(3,_1fr)_auto]"
  >
    <div>
      <h4 class="mb-4 mt-0 font-semibold">Réseaux sociaux</h4>
      <ul class="flex flex-col gap-2">
        <li>
          <a
            class="inline-flex items-center gap-2 underline duration-150 hover:translate-x-2 hover:opacity-80"
            href="https://www.instagram.com/fede_fpms/"
          >
            <Instagram />
            Instagram
          </a>
        </li>
        <li>
          <a
            class="inline-flex items-center gap-2 underline duration-150 hover:translate-x-2 hover:opacity-80"
            href="https://www.instagram.com/scientifique.fpms/"
          >
            <Mail />
            fpms.scientifique@umons.ac.be
          </a>
        </li>
      </ul>
    </div>
    <div class="h-[2px] rounded-full bg-white md:hidden"></div>
    <div>
      <h4 class="mb-4 mt-0 font-semibold">© Site développé par</h4>
      <ul class="flex flex-col gap-2">
        <li>Hugo Ranwet</li>
        <li>Gaultier Saussez</li>
        <li>Elisa Sobrie</li>
        <li>Raphaël Vergucht</li>
      </ul>
    </div>
    <div class="h-[2px] rounded-full bg-white md:hidden"></div>

    <a
      href="/"
      class="inline-flex items-center gap-2 duration-150 hover:opacity-80"
    >
      <Image
        src={logo}
        alt="Logo du Cercle Scientifique FPMs"
        class="w-24"
      />
    </a>
  </div>
</footer>